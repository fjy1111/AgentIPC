# AgentIPC local environment example.
# Copy to .env only if needed. AgentIPC does not automatically load this file.
# B082 scripts read exported environment variables only; they never source .env.

# Python / virtual environment
AGENTIPC_PYTHON=python3
AGENTIPC_VENV_DIR=.venv
AGENTIPC_BIN=

# Benchmark wrapper
AGENTIPC_BENCHMARK_PROVIDER=mock
AGENTIPC_BENCHMARK_SEED=42
AGENTIPC_BENCHMARK_REPEAT=3
AGENTIPC_RESULTS_ROOT=results

# Test wrapper log directory. Empty uses ${TMPDIR:-/tmp}/agentipc-logs.
AGENTIPC_TEST_LOG_DIR=

# Optional OpenAI-compatible provider configuration.
# These are placeholders only. Do not commit real credentials.
OPENAI_API_KEY=
OPENAI_BASE_URL=
AGENTIPC_LLM_MODEL=
AGENTIPC_EMBEDDING_MODEL=
AGENTIPC_EMBEDDING_DIM=

# Current B082 benchmark wrapper simply forwards provider selection to the
# existing AgentIPC CLI. The current smoke CLI supports mock unless later
# product work explicitly adds another provider.
