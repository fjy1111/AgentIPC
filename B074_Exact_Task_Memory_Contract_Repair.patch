+def test_exact_task_result_has_priority_before_top_k(tmp_path) -> None:
+    store, service = build_service(
+        tmp_path,
+        {
+            "exact-query": [1.0, 0.0],
+            "exact-unrelated": [0.0, 1.0],
+            "high-hybrid": [1.0, 0.0],
