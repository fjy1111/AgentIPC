+                "B",
+                "high-hybrid",
+                task_topic="other-query",
+                keywords=["kw"],
+                tags=["tag"],
+            )
+        )
+
+        refs = service.retrieve(
+            "exact-query",
+            keywords=["kw"],
+            tags=["tag"],
+            top_k=1,
+        )
+
+        assert [ref.memory_id for ref in refs] == ["A"]
+        assert refs[0].score == pytest.approx(0.0)
+        assert refs[0].match_type == "exact_task"
+    finally:
+        store.close()
+
